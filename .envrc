# direnv config — OPTIONAL, for Mac/Linux QA engineers.
#
# What this does:
#   When you `cd` into this repo, direnv auto-loads .env into your shell so
#   `claude` and `opencode` can read ${TAVILY_API_KEY}, ${ATLASSIAN_*}, etc.
#   without going through the `bun claude` wrapper.
#
# Setup (one-time per QA engineer):
#   1. Install direnv:
#        macOS:   brew install direnv
#        Linux:   apt install direnv  (or your distro's package manager)
#   2. Suppress verbose export log — add BEFORE the hook in ~/.zshrc or ~/.bashrc:
#        export DIRENV_LOG_FORMAT=""
#        (Note: does not work on Windows/Git Bash — direnv 2.37.1 writes logs to stdout)
#   3. Add the shell hook to your ~/.zshrc or ~/.bashrc:
#        eval "$(direnv hook zsh)"     # for zsh
#        eval "$(direnv hook bash)"    # for bash
#   4. Reload your shell, cd into this repo, then run: direnv allow
#      (Required for security — direnv won't load any .envrc without explicit approval.)
#
# Windows note:
#   direnv has friction on Windows (requires WSL or Git Bash, and PowerShell
#   profile access). Windows users: stick with `bun claude` / `bun opencode`
#   from package.json — same .env, cross-platform, no extra setup.

# Portable POSIX loader — works on direnv 2.21+ (does NOT require 2.30's
# dotenv_if_exists, so older Linux distros / corporate installs still work).
if [ -f .env ]; then
  set -a
  . .env
  set +a
fi

# MCP Builder — generate default MCP configs (gitignored) with the "base" kit.
bun run mcps-kit-default
bun run mcps-kit-help

# QA Role Model Selector — show help on cd
bun run qa-role:model:select:help
